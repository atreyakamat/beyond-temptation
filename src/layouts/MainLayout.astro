---
import "../styles/global.css";
import { links, site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  dark?: boolean;
}

const { title, description = site.description, dark = false } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: site.name,
  description: site.description,
  telephone: site.phone,
  priceRange: "₹",
  servesCuisine: ["Fast Food", "Burgers", "Pizza", "Coffee", "Desserts"],
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.line1,
    addressLocality: "Mapusa",
    addressRegion: "Goa",
    postalCode: "403507",
    addressCountry: "IN",
  },
  sameAs: [links.instagram, `https://facebook.com/${site.facebook}`],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFD60A" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={`min-h-screen font-sans ${dark ? "bg-ink text-paper" : "bg-paper text-ink"}`}>
    <slot />
  </body>
</html>
