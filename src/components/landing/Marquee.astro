---
interface Props {
  items?: string[];
  tone?: "yellow" | "black";
}
const {
  items = ["Burgers", "Pizza", "Thick shakes", "Cold coffee", "Loaded sandwiches", "Brownie sizzlers", "Mapusa"],
  tone = "yellow",
} = Astro.props;
const wrap = tone === "yellow" ? "bg-yellow text-ink" : "bg-ink text-yellow";
const doubled = [...items, ...items];
---

<div class={`overflow-hidden border-y-4 border-ink py-3 ${wrap}`} aria-hidden="true">
  <div class="flex w-max animate-marquee whitespace-nowrap font-display text-2xl font-extrabold md:text-4xl">
    {doubled.map((t) => (
      <span class="flex items-center">
        <span class="px-6">{t}</span>
        <span class="inline-block h-3 w-3 rotate-45 bg-current"></span>
      </span>
    ))}
  </div>
</div>
