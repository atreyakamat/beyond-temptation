---
import { links, site } from "../../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
  <div class="hazard h-4"></div>
  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-5 py-14 md:flex-row md:items-end md:justify-between md:px-10">
    <div>
      <p class="font-display text-display-md text-yellow">{site.name}</p>
      <p class="mt-2 max-w-xs text-paper/70">{site.tagline} {site.hoursShort}.</p>
    </div>
    <div class="flex flex-wrap gap-x-8 gap-y-3 font-display text-lg font-bold">
      <a href={links.instagram} target="_blank" rel="noopener" class="hover:text-yellow">Instagram</a>
      <a href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noopener" class="hover:text-yellow">Facebook</a>
      <a href={links.whatsapp()} target="_blank" rel="noopener" class="hover:text-yellow">WhatsApp</a>
      <a href={links.maps} target="_blank" rel="noopener" class="hover:text-yellow">Maps</a>
    </div>
  </div>
  <p class="border-t border-paper/10 px-5 py-5 text-center text-sm text-paper/50">
    © {year} {site.name}, {site.address.line2}
  </p>
</footer>
