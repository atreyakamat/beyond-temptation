---
import MainLayout from "../layouts/MainLayout.astro";
import Nav from "../components/landing/Nav";
import Hero from "../components/landing/Hero";
import Marquee from "../components/landing/Marquee";
import Intro from "../components/landing/Intro";
import SmoothScroll from "../components/landing/SmoothScroll";
import Bestsellers from "../components/landing/Bestsellers";
import Vibe from "../components/landing/Vibe";
import Proof from "../components/landing/Proof";
import ShakeWall from "../components/landing/ShakeWall";
import Signature from "../components/landing/Signature";
import Reviews from "../components/landing/Reviews";
import Visit from "../components/landing/Visit.astro";
import Footer from "../components/landing/Footer.astro";
import MobileBar from "../components/landing/MobileBar";
import { site } from "../data/site";
---

<MainLayout title={`${site.name} — Café in Mapusa, Goa`} dark>
  <Intro client:load />
  <SmoothScroll client:load />
  <Nav client:load />
  <main>
    <Hero client:load />
    <Marquee client:load />
    <Signature client:visible />
    <Bestsellers client:visible />
    <Marquee client:visible tone="black" seed={1} />
    <ShakeWall client:visible />
    <Vibe client:visible />
    <Reviews client:visible />
    <Proof client:visible />
    <Visit />
  </main>
  <Footer />
  <MobileBar client:idle />
</MainLayout>
