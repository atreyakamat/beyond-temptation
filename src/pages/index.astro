---
import MainLayout from "../layouts/MainLayout.astro";
import Nav from "../components/landing/Nav";
import Hero from "../components/landing/Hero";
import Marquee from "../components/landing/Marquee.astro";
import Bestsellers from "../components/landing/Bestsellers";
import Vibe from "../components/landing/Vibe";
import Proof from "../components/landing/Proof";
import Visit from "../components/landing/Visit.astro";
import Footer from "../components/landing/Footer.astro";
import MobileBar from "../components/landing/MobileBar";
import { site } from "../data/site";
---

<MainLayout title={`${site.name} — Café in Mapusa, Goa`} dark>
  <Nav client:load />
  <main>
    <Hero client:load />
    <Marquee />
    <Bestsellers client:visible />
    <Marquee tone="black" items={["Open daily", "Dine in", "Takeaway", "WhatsApp orders", "Birthdays & events"]} />
    <Vibe client:visible />
    <Proof client:visible />
    <Visit />
  </main>
  <Footer />
  <MobileBar client:idle />
</MainLayout>
