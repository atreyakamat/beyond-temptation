---
import MainLayout from "../layouts/MainLayout.astro";
import Nav from "../components/landing/Nav";
import MenuList from "../components/landing/Menu";
import Footer from "../components/landing/Footer.astro";
import MobileBar from "../components/landing/MobileBar";
import SmoothScroll from "../components/landing/SmoothScroll";
import { RevealLines } from "../components/landing/motion";
import { site } from "../data/site";
---

<MainLayout title={`Menu — ${site.name}, Mapusa`} description="Full menu with prices: shakes, cold coffee, coolers, fries, burgers, pizzas, sandwiches, brownies. Order on WhatsApp." dark>
  <SmoothScroll client:load />
  <Nav client:load solid />
  <main class="bg-cream pb-24 pt-28 text-ink md:pt-36">
    <div class="mx-auto max-w-7xl px-5 md:px-10">
      <RevealLines client:load as="h1" lines={["The menu.", "All of it."]} className="font-display text-display-lg" />
      <p class="mt-4 max-w-md text-lg text-smoke">
        Prices as on the counter board. Place your order at the counter, or send it ahead on WhatsApp. Also on Swiggy and Zomato.
      </p>
    </div>
    <div class="mt-10">
      <MenuList client:load />
    </div>
  </main>
  <Footer />
  <MobileBar client:idle />
</MainLayout>
