---
import MainLayout from "../layouts/MainLayout.astro";
import Nav from "../components/landing/Nav";
import Visit from "../components/landing/Visit.astro";
import Footer from "../components/landing/Footer.astro";
import MobileBar from "../components/landing/MobileBar";
import SmoothScroll from "../components/landing/SmoothScroll";
import { site, links } from "../data/site";

const ways = [
  { t: "Landmarks", d: `${site.address.landmark}. Opposite St. Britto School, Dangui Colony, Alto.` },
  { t: "From Mapusa market", d: "A few minutes up the Alto road. Hidden from the market crowd, which is the point." },
  { t: "Delivery", d: "On Swiggy and Zomato if you're not leaving the house. WhatsApp for pickup." },
];
---

<MainLayout title={`Visit — ${site.name}, Mapusa`} description={`Find Beyond Temptation: ${site.address.full}. Mon–Sat 10 am–9 pm.`} dark>
  <SmoothScroll client:load />
  <Nav client:load solid />
  <main class="bg-cream pt-20 text-ink md:pt-24">
    <Visit />
    <section class="bg-ink py-16 text-paper md:py-20">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 md:grid-cols-3 md:px-10">
        {ways.map((w) => (
          <div class="rounded-2xl border-2 border-yellow/40 p-6">
            <p class="font-display text-2xl font-extrabold text-yellow">{w.t}</p>
            <p class="mt-2 font-accent text-xl italic text-paper/80">{w.d}</p>
          </div>
        ))}
      </div>
      <div class="mx-auto mt-10 flex max-w-7xl flex-wrap gap-3 px-5 md:px-10">
        <a href={links.maps} target="_blank" rel="noopener" class="rounded-full bg-yellow px-6 py-4 font-display text-lg font-bold text-ink shadow-hard-yellow">Open in Google Maps</a>
        <a href={links.whatsapp("Hi! Can you share the location pin?")} target="_blank" rel="noopener" class="rounded-full border-2 border-yellow px-6 py-4 font-display text-lg font-bold text-yellow">Ask for the pin on WhatsApp</a>
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar client:idle />
</MainLayout>
