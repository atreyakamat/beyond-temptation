---
import MainLayout from "../layouts/MainLayout.astro";
import Nav from "../components/landing/Nav";
import Gallery from "../components/landing/Gallery";
import Footer from "../components/landing/Footer.astro";
import MobileBar from "../components/landing/MobileBar";
import SmoothScroll from "../components/landing/SmoothScroll";
import { RevealLines } from "../components/landing/motion";
import { site } from "../data/site";
---

<MainLayout title={`Gallery — ${site.name}, Mapusa`} description="Photos and reels from Beyond Temptation café, Mapusa." dark>
  <SmoothScroll client:load />
  <Nav client:load solid />
  <main class="bg-cream pb-24 pt-28 text-ink md:pt-36">
    <div class="mx-auto max-w-7xl px-5 md:px-10">
      <RevealLines client:load as="h1" lines={["Proof we're", "not making it up."]} className="font-display text-display-lg" />
      <p class="mt-4 max-w-md font-accent text-2xl italic text-smoke">
        The plates, the people, the reels. Tag @{site.instagram} and yours might land here.
      </p>
    </div>
    <div class="mt-10">
      <Gallery client:load />
    </div>
  </main>
  <Footer />
  <MobileBar client:idle />
</MainLayout>
